    "Photos are paused for a while. Text still sends.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf gönderimi bir süreliğine duraklatıldı. Metin gönderilmeye devam eder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos sind gerade pausiert. Text kannst du weiterhin senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El envío de fotos está en pausa por ahora. Puedes seguir enviando texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi de photos est suspendu pour le moment. Vous pouvez toujours envoyer du texte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の送信はしばらく停止中です。テキストは送信できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال الصور متوقف مؤقتًا. لا يزال بإمكانك إرسال النصوص."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio de fotos está pausado por um tempo. Você ainda pode enviar texto."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El envío de fotos está en pausa por un rato. Puedes seguir enviando texto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’invio di foto è sospeso per un po’. Puoi comunque inviare messaggi di testo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s zijn even gepauzeerd. Tekst wordt nog wel verstuurd."
          }
        },
        "ru": {
          "stringUnit": {
