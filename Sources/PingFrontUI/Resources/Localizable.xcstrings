            "value": "আপনি এই চ্যাটে মেসেজ পাঠাতে পারবেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No pots enviar missatges en aquest xat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto chatu nemůžete posílat zprávy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke sende beskeder i denne chat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορείτε να στέλνετε μηνύματα σε αυτή τη συνομιλία."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمی‌توانید در این گفتگو پیام بفرستید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et voi lähettää viestejä tässä chatissa."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U ovom chatu ne možete slati poruke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebben a csevegésben nem küldhetsz üzenetet."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tidak boleh menghantar mesej dalam sembang ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke sende meldinger i denne chatten."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode enviar mensagens neste chat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu puteți trimite mesaje în acest chat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto chate nemôžete posielať správy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V tem klepetu ne morete pošiljati sporočil."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த சாட்டில் உங்களால் மெசேஜ் அனுப்ப முடியாது."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas envoyer de messages dans ce clavardage."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你無法在此聊天中傳送訊息。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही या चॅटमध्ये मेसेज पाठवू शकत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે આ ચેટમાં મેસેજ મોકલી શકતા નથી."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఈ చాట్‌లో మెసేజ్‌లు పంపలేరు."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ചാറ്റിൽ നിങ്ങൾക്ക് മെസേജുകൾ അയയ്ക്കാനാകില്ല."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଏହି ଚାଟରେ ମେସେଜ୍ ପଠାଇପାରିବେ ନାହିଁ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಚಾಟ್‌ನಲ್ಲಿ ನೀವು ಮೆಸೇಜ್‌ಗಳನ್ನು ಕಳುಹಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਇਸ ਚੈਟ ਵਿੱਚ ਮੈਸੇਜ ਨਹੀਂ ਭੇਜ ਸਕਦੇ।"
          }
        }
      }
    },
    "You're offline. Messages will send when you're back online.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışısın. Mesajlar yeniden bağlandığında gönderilecek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Nachrichten werden gesendet, sobald du wieder online bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Los mensajes se enviarán cuando vuelvas a estar en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Les messages partiront dès le retour de la connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。オンラインに戻るとメッセージが送信されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل. ستُرسل الرسائل عند عودة الاتصال."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está offline. As mensagens serão enviadas quando você voltar a ficar online."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes conexión. Los mensajes se enviarán cuando vuelvas a estar en línea."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline. I messaggi verranno inviati quando tornerai online."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent offline. Berichten worden verstuurd zodra je weer online bent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сети. Сообщения отправятся, когда подключение восстановится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає мережі. Повідомлення надішлються, щойно з’явиться з’єднання."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś offline. Wiadomości zostaną wysłane, gdy wrócisz do sieci."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är offline. Meddelanden skickas när du är online igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已离线。恢复联网后会发送消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前離線。恢復連線後就會傳送訊息。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태입니다. 다시 연결되면 메시지가 전송됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ngoại tuyến. Tin nhắn sẽ được gửi khi có mạng trở lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออฟไลน์อยู่ ข้อความจะถูกส่งเมื่อกลับมาออนไลน์"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חיבור לאינטרנט. ההודעות יישלחו כשהחיבור יחזור."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ آف لائن ہیں۔ آن لائن ہوتے ہی پیغامات بھیج دیے جائیں گے۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं। ऑनलाइन होते ही मैसेज भेज दिए जाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sedang offline. Pesan akan terkirim saat Anda kembali online."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нямате връзка с интернет. Съобщенията ще се изпратят, когато се свържете отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি অফলাইনে আছেন। আবার অনলাইনে এলে মেসেজ পাঠানো হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No tens connexió. Els missatges s’enviaran quan tornis a estar en línia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste offline. Zprávy se odešlou, až budete zase online."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er offline. Beskeder sendes, når du er online igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε εκτός σύνδεσης. Τα μηνύματα θα σταλούν όταν συνδεθείτε ξανά."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آفلاین هستید. پیام‌ها وقتی دوباره آنلاین شوید ارسال می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet offline-tilassa. Viestit lähetetään, kun yhteys palaa."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niste povezani s internetom. Poruke će se poslati kad se ponovno povežete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs internetkapcsolat. Az üzenetek elmennek, amint újra online leszel."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda di luar talian. Mesej akan dihantar apabila anda kembali dalam talian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er frakoblet. Meldinger sendes når du er på nett igjen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está offline. As mensagens serão enviadas quando voltar a estar online."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunteți offline. Mesajele se vor trimite când reveniți online."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ste offline. Správy sa odošlú, keď budete znova online."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niste povezani z internetom. Sporočila bodo poslana, ko se znova povežete."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஆஃப்லைனில் இருக்கிறீர்கள். மீண்டும் ஆன்லைனுக்கு வந்ததும் மெசேஜ்கள் அனுப்பப்படும்."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Les messages partiront dès que vous serez de nouveau en ligne."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前離線。恢復連線後就會傳送訊息。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही ऑफलाइन आहात. तुम्ही पुन्हा ऑनलाइन आल्यावर मेसेज पाठवले जातील."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ઑફલાઇન છો. તમે ફરી ઑનલાઇન થશો ત્યારે મેસેજ મોકલાશે."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఆఫ్‌లైన్‌లో ఉన్నారు. మీరు మళ్లీ ఆన్‌లైన్‌కి రాగానే మెసేజ్‌లు పంపబడతాయి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഓഫ്‌ലൈനാണ്. വീണ്ടും ഓൺലൈനാകുമ്പോൾ മെസേജുകൾ അയയ്ക്കും."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଅଫଲାଇନ୍ ଅଛନ୍ତି। ଆପଣ ପୁଣି ଅନଲାଇନ୍ ହେଲେ ମେସେଜ୍ ପଠାଯିବ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿದ್ದೀರಿ. ನೀವು ಮತ್ತೆ ಆನ್‌ಲೈನ್‌ಗೆ ಬಂದಾಗ ಮೆಸೇಜ್‌ಗಳನ್ನು ಕಳುಹಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਆਫ਼ਲਾਈਨ ਹੋ। ਆਨਲਾਈਨ ਹੁੰਦੇ ਹੀ ਮੈਸੇਜ ਭੇਜ ਦਿੱਤੇ ਜਾਣਗੇ।"
          }
        }
      }
    },
