        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple pregleda zahtevo in vam odgovori po e-pošti."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple கோரிக்கையைப் பரிசீலித்து உங்களுக்கு மின்னஞ்சல் அனுப்பும்."
          }
