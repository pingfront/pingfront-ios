    "Can't reach the chat right now. Messages will send when it's back.": {
      "comment": "Banner under the header when the device has a network but the chat's service can't be reached.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى المحادثة الآن. ستُرسل الرسائل عند عودتها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чатът не е достъпен в момента. Съобщенията ще се изпратят, когато се върне."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে চ্যাটে পৌঁছানো যাচ্ছে না। চ্যাট ফিরে এলে মেসেজ পাঠানো হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara mateix no es pot accedir al xat. Els missatges s’enviaran quan torni."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat je teď nedostupný. Zprávy se odešlou, až bude zase dostupný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatten kan ikke nås lige nu. Beskeder sendes, når den er tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Chat ist gerade nicht erreichbar. Nachrichten werden gesendet, sobald er wieder da ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συνομιλία δεν είναι διαθέσιμη αυτή τη στιγμή. Τα μηνύματα θα σταλούν μόλις επανέλθει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder al chat ahora. Los mensajes se enviarán cuando vuelva."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder al chat ahora. Los mensajes se enviarán cuando vuelva."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اکنون دسترسی به گفتگو ممکن نیست. پیام‌ها پس از بازگشت آن ارسال می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskusteluun ei saada nyt yhteyttä. Viestit lähtevät, kun se palaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le chat pour le moment. Les messages partiront dès son retour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר להגיע לצ׳אט כרגע. ההודעות יישלחו כשהוא יחזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी चैट तक नहीं पहुंच पा रहे। चैट वापस आते ही मैसेज भेज दिए जाएंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat trenutačno nije dostupan. Poruke će se poslati kad se vrati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csevegés most nem érhető el. Az üzenetek elmennek, amint újra elérhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat tidak dapat dijangkau saat ini. Pesan akan dikirim saat chat kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento la chat non è raggiungibile. I messaggi partiranno quando tornerà disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在チャットに接続できません。復旧するとメッセージが送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 채팅에 연결할 수 없습니다. 복구되면 메시지가 전송됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembang tidak dapat dicapai sekarang. Mesej akan dihantar apabila ia kembali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatten kan ikke nås akkurat nå. Meldinger sendes når den er tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De chat is nu niet bereikbaar. Berichten worden verstuurd zodra hij terug is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czat jest teraz niedostępny. Wiadomości zostaną wysłane, gdy wróci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o chat agora. As mensagens serão enviadas quando ele voltar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível aceder ao chat agora. As mensagens serão enviadas quando voltar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatul nu poate fi accesat acum. Mesajele vor fi trimise când revine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
