    "Reply if you like, or ignore it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstersen yanıtla, istersen görmezden gel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworte, wenn du magst, oder ignoriere sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde si quieres, o ignóralo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez si vous le souhaitez, ou ignorez-le."
          }
        },
