        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法連線到聊天。恢復後會傳送訊息。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’accéder au clavardage pour le moment. Les messages partiront dès son retour."
