        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi gói, phương thức thanh toán hoặc gia hạn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนแผน วิธีการชำระเงิน หรือการต่ออายุ"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי התוכנית, אמצעי התשלום או החידוש."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا پلان، ادائیگی کا طریقہ یا تجدید تبدیل کریں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना प्लान, पेमेंट का तरीका या रिन्यूअल बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah paket, metode pembayaran, atau perpanjangan Anda."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сменете плана, начина на плащане или подновяването."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্ল্যান, পেমেন্টের পদ্ধতি বা রিনিউয়াল বদলান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvia el pla, el mètode de pagament o la renovació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změňte tarif, platební metodu nebo obnovení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift abonnement, betalingsmetode eller fornyelse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάξτε το πρόγραμμα, τον τρόπο πληρωμής ή την ανανέωση."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "طرح، روش پرداخت یا تمدید را تغییر دهید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuta tilausta, maksutapaa tai uusiutumista."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promijenite plan, način plaćanja ili obnovu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Módosítsd a csomagot, a fizetési módot vagy a megújítást."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar pelan, kaedah pembayaran atau pembaharuan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt abonnement, betalingsmåte eller fornyelse."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere o plano, o método de pagamento ou a renovação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbați planul, metoda de plată sau reînnoirea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmeňte plán, spôsob platby alebo obnovenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremenite paket, način plačila ali podaljšanje."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் திட்டம், பேமெண்ட் முறை அல்லது புதுப்பித்தலை மாற்றவும்."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez votre forfait, votre mode de paiement ou le renouvellement."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "更改計劃、付款方式或續訂設定。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा प्लॅन, पेमेंट पद्धत किंवा नूतनीकरण बदला."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો પ્લાન, ચુકવણી પદ્ધતિ અથવા રિન્યૂઅલ બદલો."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్లాన్, చెల్లింపు పద్ధతి లేదా రెన్యూవల్‌ను మార్చండి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പ്ലാൻ, പേയ്‌മെന്റ് രീതി അല്ലെങ്കിൽ പുതുക്കൽ മാറ്റുക."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ପ୍ଲାନ୍, ପେମେଣ୍ଟ ପଦ୍ଧତି କିମ୍ବା ରିନ୍ୟୁଆଲ୍ ବଦଳାନ୍ତୁ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪ್ಲಾನ್, ಪಾವತಿ ವಿಧಾನ ಅಥವಾ ನವೀಕರಣವನ್ನು ಬದಲಾಯಿಸಿ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣਾ ਪਲਾਨ, ਭੁਗਤਾਨ ਵਿਧੀ ਜਾਂ ਰੀਨਿਊਅਲ ਬਦਲੋ।"
          }
        }
      }
    },
