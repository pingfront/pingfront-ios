    "Pinch to zoom. Swipe down to close.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch to zoom. Swipe down to close."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınlaştırmak için parmaklarını aç. Kapatmak için aşağı kaydır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Zoomen auseinanderziehen. Zum Schließen nach unten wischen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pellizca para ampliar. Desliza hacia abajo para cerrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pincez pour zoomer. Balayez vers le bas pour fermer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンチで拡大、下にスワイプで閉じます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب بإصبعين. اسحب لأسفل للإغلاق."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o gesto de pinça para ampliar. Deslize para baixo para fechar."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Pellizca para hacer zoom. Desliza hacia abajo para cerrar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizzica per ingrandire. Scorri verso il basso per chiudere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knijp om te zoomen. Veeg omlaag om te sluiten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разведите пальцы, чтобы увеличить. Смахните вниз, чтобы закрыть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розведіть пальці, щоб збільшити. Змахніть униз, щоб закрити."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozsuń palce, aby powiększyć. Przesuń w dół, aby zamknąć."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyp för att zooma. Svep nedåt för att stänga."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双指捏合可缩放，向下轻扫可关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙指開合可縮放，向下滑動可關閉。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핀치하여 확대/축소하고, 아래로 쓸어내려 닫습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụm để thu phóng. Vuốt xuống để đóng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จีบนิ้วเพื่อซูม ปัดลงเพื่อปิด"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צביטה להגדלה. החלקה למטה לסגירה."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زوم کرنے کے لیے پنچ کریں۔ بند کرنے کے لیے نیچے سوائپ کریں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़ूम करने के लिए पिंच करें। बंद करने के लिए नीचे स्वाइप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubit untuk memperbesar. Gesek ke bawah untuk menutup."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разтворете пръсти за увеличение. Плъзнете надолу за затваряне."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জুম করতে পিঞ্চ করুন। বন্ধ করতে নিচে সোয়াইপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pessiga per fer zoom. Llisca cap avall per tancar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Roztažením prstů přiblížíte. Přejetím dolů zavřete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knib for at zoome. Skub ned for at lukke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τσιμπήστε για μεγέθυνση. Σαρώστε προς τα κάτω για κλείσιμο."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای بزرگ‌نمایی، دو انگشت را از هم باز کنید. برای بستن، به پایین بکشید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoomaa nipistämällä. Sulje pyyhkäisemällä alas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raširite prste za zumiranje. Povucite prema dolje za zatvaranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csippentéssel nagyíthatsz. Lefelé legyintve bezárhatod."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubit untuk zum. Leret ke bawah untuk menutup."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Knip for å zoome. Sveip ned for å lukke."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Junte ou afaste os dedos para ampliar. Deslize para baixo para fechar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciupiți pentru zoom. Glisați în jos pentru a închide."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Roztiahnutím prstov priblížite. Potiahnutím nadol zavriete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Razprite prsta za povečavo. Podrsajte navzdol za zapiranje."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பெரிதாக்க பிஞ்ச் செய்யவும். மூட கீழே ஸ்வைப் செய்யவும்."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pincez pour zoomer. Balayez vers le bas pour fermer."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "兩指開合可縮放，向下掃可關閉。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "झूम करण्यासाठी पिंच करा. बंद करण्यासाठी खाली स्वाइप करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઝૂમ કરવા માટે પિંચ કરો. બંધ કરવા માટે નીચે સ્વાઇપ કરો."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "జూమ్ చేయడానికి పించ్ చేయండి. మూసివేయడానికి కిందికి స్వైప్ చేయండి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൂം ചെയ്യാൻ പിഞ്ച് ചെയ്യുക. അടയ്ക്കാൻ താഴേക്ക് സ്വൈപ്പ് ചെയ്യുക."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଜୁମ୍ କରିବାକୁ ପିଞ୍ଚ କରନ୍ତୁ। ବନ୍ଦ କରିବାକୁ ତଳକୁ ସ୍ୱାଇପ୍ କରନ୍ତୁ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಝೂಮ್ ಮಾಡಲು ಪಿಂಚ್ ಮಾಡಿ. ಮುಚ್ಚಲು ಕೆಳಗೆ ಸ್ವೈಪ್ ಮಾಡಿ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜ਼ੂਮ ਕਰਨ ਲਈ ਪਿੰਚ ਕਰੋ। ਬੰਦ ਕਰਨ ਲਈ ਹੇਠਾਂ ਵੱਲ ਸਵਾਈਪ ਕਰੋ।"
          }
        }
      }
    },
