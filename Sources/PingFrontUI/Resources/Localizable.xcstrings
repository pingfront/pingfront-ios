        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible uniquement dans les versions de débogage."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只會在除錯版本中顯示。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त डीबग बिल्डमध्ये दिसते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માત્ર ડિબગ બિલ્ડમાં બતાવાય છે."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డీబగ్ బిల్డ్‌లలో మాత్రమే కనిపిస్తుంది."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡീബഗ് ബിൽഡുകളിൽ മാത്രം കാണിക്കുന്നു."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେବଳ ଡିବଗ୍ ବିଲ୍ଡରେ ଦେଖାଯାଏ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಡೀಬಗ್ ಬಿಲ್ಡ್‌ಗಳಲ್ಲಿ ಮಾತ್ರ ತೋರಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ ਡੀਬੱਗ ਬਿਲਡਾਂ ਵਿੱਚ ਦਿਖਾਇਆ ਜਾਂਦਾ ਹੈ।"
          }
        }
      }
    },
