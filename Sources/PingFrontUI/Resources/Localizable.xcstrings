        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সাবস্ক্রিপশন চালু রাখতে পেমেন্টের পদ্ধতি আপডেট করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualitza el mètode de pagament per mantenir la subscripció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizujte platební metodu, abyste si předplatné zachovali."
