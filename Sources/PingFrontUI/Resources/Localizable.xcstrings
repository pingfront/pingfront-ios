    "%@. You can close this; the reply waits here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. You can close this; the reply waits here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Burayı kapatabilirsin, yanıt burada seni bekler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Du kannst den Chat schließen, die Antwort wartet hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Puedes cerrar el chat; la respuesta te esperará aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Vous pouvez fermer ; la réponse vous attendra ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。閉じても大丈夫です。返信はここに届きます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. يمكنك الإغلاق، وسينتظرك الرد هنا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Pode fechar; a resposta fica aqui."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Puedes cerrar esto; la respuesta te espera aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Puoi chiudere; la risposta ti aspetta qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Je kunt dit sluiten; het antwoord wacht hier op je."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Чат можно закрыть: ответ появится здесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Чат можна закрити: відповідь з’явиться тут."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Możesz zamknąć czat, odpowiedź pojawi się tutaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Du kan stänga chatten, svaret väntar här."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。你可以先关闭，回复会在这里等你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。你可以先關閉，回覆會在這裡等你。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 이 화면을 닫아도 됩니다. 답장은 여기에 표시됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Bạn có thể đóng màn hình này; câu trả lời sẽ chờ bạn ở đây."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ปิดหน้านี้ได้เลย คำตอบจะรออยู่ที่นี่"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. אפשר לסגור, התשובה תחכה כאן."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@۔ آپ اسے بند کر سکتے ہیں، جواب یہیں ملے گا۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@। आप इसे बंद कर सकते हैं, जवाब यहीं मिलेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Anda bisa menutupnya dulu; balasan akan muncul di sini."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Можете да затворите чата, отговорът ще Ви чака тук."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@। আপনি এটি বন্ধ করতে পারেন, উত্তর এখানেই থাকবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Pots tancar-ho; la resposta t’esperarà aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Chat můžete zavřít, odpověď na vás počká tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Du kan godt lukke chatten, svaret venter her."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Μπορείτε να κλείσετε τη συνομιλία· η απάντηση θα σας περιμένει εδώ."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. می‌توانید این را ببندید؛ پاسخ همین‌جا می‌ماند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Voit sulkea chatin, vastaus odottaa täällä."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Chat možete zatvoriti, odgovor će vas čekati ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Nyugodtan bezárhatod, a válasz itt vár."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Anda boleh menutup sembang ini; balasan akan dipaparkan di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Du kan lukke chatten, svaret venter her."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Pode fechar; a resposta fica aqui à sua espera."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Puteți închide chatul, răspunsul vă așteaptă aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Chat môžete zavrieť, odpoveď na vás počká tu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Klepet lahko zaprete, odgovor vas bo počakal tukaj."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. இதை மூடலாம், பதில் இங்கேயே காத்திருக்கும்."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Vous pouvez fermer; la réponse vous attendra ici."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。你可以先關閉，回覆會在這裡等你。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. तुम्ही हे बंद करू शकता; उत्तर येथेच मिळेल."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. તમે આ બંધ કરી શકો છો; જવાબ અહીં જ મળશે."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. మీరు దీన్ని మూసివేయవచ్చు; రిప్లై ఇక్కడే ఉంటుంది."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. നിങ്ങൾക്ക് ഇത് അടയ്ക്കാം, മറുപടി ഇവിടെത്തന്നെ ലഭിക്കും."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%@। ଆପଣ ଏହାକୁ ବନ୍ଦ କରିପାରିବେ, ଉତ୍ତର ଏଠାରେ ହିଁ ମିଳିବ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. ನೀವು ಇದನ್ನು ಮುಚ್ಚಬಹುದು; ಉತ್ತರ ಇಲ್ಲಿಯೇ ಕಾಯುತ್ತಿರುತ್ತದೆ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@। ਤੁਸੀਂ ਇਸਨੂੰ ਬੰਦ ਕਰ ਸਕਦੇ ਹੋ; ਜਵਾਬ ਇੱਥੇ ਹੀ ਮਿਲੇਗਾ।"
          }
        }
      }
    },
    "You can close this; the reply waits here.": {
      "localizations": {
        "en": {
