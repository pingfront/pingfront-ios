    "I'd like to talk to a person, please.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek bir kişiyle konuşabilir miyim?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich möchte bitte mit einem Menschen sprechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me gustaría hablar con una persona, por favor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’aimerais parler à une personne, s’il vous plaît."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "担当者と話したいです。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرغب في التحدث إلى شخص، من فضلك."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quero falar com uma pessoa, por favor."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiero hablar con una persona, por favor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorrei parlare con una persona, per favore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik wil graag met een mens praten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно поговорить с человеком?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна поговорити з людиною?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proszę o rozmowę z człowiekiem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag vill gärna prata med en människa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我想和真人沟通，谢谢。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我想和真人聊聊，謝謝。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람과 직접 이야기하고 싶어요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi muốn nói chuyện với người thật."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยากคุยกับทีมงานโดยตรง"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשמח לדבר עם נציג, בבקשה."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "براہ کرم، مجھے کسی انسان سے بات کرنی ہے۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया, मुझे किसी व्यक्ति से बात करनी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya ingin bicara langsung dengan tim."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Може ли да говоря с човек?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুগ্রহ করে, আমি কোনো মানুষের সঙ্গে কথা বলতে চাই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Voldria parlar amb una persona, si us plau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mohu prosím mluvit s člověkem?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg vil gerne tale med et menneske."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα ήθελα να μιλήσω με έναν άνθρωπο, παρακαλώ."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لطفاً می‌خواهم با یک نفر صحبت کنم."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluaisin puhua ihmisen kanssa."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogu li razgovarati s osobom?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szeretnék egy emberrel beszélni."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya ingin bercakap terus dengan pasukan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg vil gjerne snakke med et menneske."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gostaria de falar com uma pessoa, por favor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aș dori să vorbesc cu un om, vă rog."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžem sa, prosím, porozprávať s človekom?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lahko pogovorim s človekom?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தயவுசெய்து, நான் ஒரு நபரிடம் நேரடியாகப் பேச விரும்புகிறேன்."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "J’aimerais parler à une personne, s’il vous plaît."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "我想和真人溝通，謝謝。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया, मला एखाद्या व्यक्तीशी बोलायचे आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કૃપા કરીને, મારે કોઈ વ્યક્તિ સાથે વાત કરવી છે."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దయచేసి, నేను ఒక వ్యక్తితో మాట్లాడాలనుకుంటున్నాను."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദയവായി, എനിക്ക് ഒരു വ്യക്തിയുമായി സംസാരിക്കണം."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦୟାକରି, ମୁଁ ଜଣେ ବ୍ୟକ୍ତିଙ୍କ ସହ କଥା ହେବାକୁ ଚାହେଁ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಯವಿಟ್ಟು, ನಾನು ಒಬ್ಬ ವ್ಯಕ್ತಿಯೊಂದಿಗೆ ಮಾತನಾಡಲು ಬಯಸುತ್ತೇನೆ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
