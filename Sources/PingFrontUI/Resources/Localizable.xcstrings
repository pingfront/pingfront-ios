    "Apple reviews the request and emails you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple reviews the request and emails you."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple talebi inceler ve sana e-posta gönderir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple prüft die Anfrage und schreibt dir per E-Mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple revisa la solicitud y te envía un correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple examine la demande et vous envoie un e-mail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleがリクエストを確認し、メールでお知らせします。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تراجع Apple الطلب وترسل إليك بريدًا إلكترونيًا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple analisa o pedido e envia um e-mail para você."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple revisa la solicitud y te envía un correo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple esamina la richiesta e ti scrive via email."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple bekijkt het verzoek en mailt je."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple рассмотрит запрос и ответит по электронной почте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple розгляне запит і відповість електронною поштою."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple rozpatrzy prośbę i odpowie e-mailem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple granskar begäran och mejlar dig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 会审核申请并通过电子邮件通知你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 會審核要求，並以電子郵件通知你。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 요청을 검토한 후 이메일로 알려 드립니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sẽ xem xét yêu cầu và gửi email cho bạn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple จะตรวจสอบคำขอและแจ้งให้คุณทราบทางอีเมล"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple תבדוק את הבקשה ותשלח לך דוא״ל."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple درخواست کا جائزہ لے کر آپ کو ای میل کرے گا۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple अनुरोध की समीक्षा करके आपको ईमेल करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple akan meninjau permintaan dan mengirimi Anda email."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ще разгледа заявката и ще Ви пише по имейл."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple অনুরোধটি পর্যালোচনা করে আপনাকে ইমেল করবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple revisa la sol·licitud i t’envia un correu electrònic."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple žádost posoudí a pošle vám e-mail."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gennemgår anmodningen og sender dig en e-mail."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Apple εξετάζει το αίτημα και σας ενημερώνει με email."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple درخواست را بررسی می‌کند و نتیجه را به شما ایمیل می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple käsittelee pyynnön ja vastaa sinulle sähköpostitse."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple pregledava zahtjev i javlja vam se e-poštom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple elbírálja a kérést, és e-mailben értesít."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple menyemak permintaan itu dan menghantar e-mel kepada anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple behandler forespørselen og sender deg en e-post."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple analisa o pedido e envia-lhe um e-mail."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple analizează solicitarea și vă trimite un e-mail."
