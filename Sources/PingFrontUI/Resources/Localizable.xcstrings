    "Draw on the screenshot to point at the problem. Recent logs and device state are attached.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorunu göstermek için ekran görüntüsünün üzerine çiz. Son kayıtlar ve cihaz durumu eklenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne auf den Screenshot, um das Problem zu zeigen. Aktuelle Logs und der Gerätestatus werden angehängt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja sobre la captura para señalar el problema. Se adjuntan los registros recientes y el estado del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez sur la capture pour montrer le problème. Les journaux récents et l’état de l’appareil sont joints."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットに描いて問題の場所を示してください。最近のログと端末の状態が添付されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسم على لقطة الشاشة لتحديد المشكلة. تُرفق السجلات الأخيرة وحالة الجهاز."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe na captura para mostrar o problema. Os logs recentes e o estado do aparelho serão anexados."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja en la captura para señalar el problema. Se adjuntan los registros recientes y el estado del dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna sullo screenshot per indicare il problema. I log recenti e lo stato del dispositivo vengono allegati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken op de screenshot om het probleem aan te wijzen. Recente logs en de apparaatstatus worden bijgevoegd."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте проблему на снимке экрана. Недавние логи и данные об устройстве будут приложены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте проблему на знімку екрана. Нещодавні логи й дані про пристрій буде додано."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz problem na zrzucie ekranu. Dołączymy najnowsze logi i stan urządzenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rita på skärmbilden för att visa problemet. Senaste loggar och enhetsstatus bifogas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在截屏上圈出问题所在。最近的日志和设备状态会一并附上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在截圖上圈出問題所在。最近的記錄檔和裝置狀態會一併附上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷에 표시하여 문제가 있는 곳을 알려 주세요. 최근 로그와 기기 상태가 함께 첨부됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẽ lên ảnh chụp màn hình để chỉ ra vấn đề. Nhật ký gần đây và trạng thái thiết bị sẽ được đính kèm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วาดบนภาพหน้าจอเพื่อชี้จุดที่มีปัญหา ระบบจะแนบบันทึกล่าสุดและสถานะอุปกรณ์ไปด้วย"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לצייר על צילום המסך כדי להראות איפה הבעיה. יומנים אחרונים ומצב המכשיר מצורפים."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مسئلے کی نشاندہی کے لیے اسکرین شاٹ پر نشان لگائیں۔ حالیہ لاگز اور ڈیوائس کی حالت منسلک ہیں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समस्या दिखाने के लिए स्क्रीनशॉट पर निशान बनाएँ। हाल के लॉग और डिवाइस की स्थिति अटैच की जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar di tangkapan layar untuk menunjukkan masalahnya. Log terbaru dan status perangkat akan dilampirkan."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисувайте върху екранната снимка, за да посочите проблема. Прилагат се скорошните логове и състоянието на устройството."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমস্যাটি দেখাতে স্ক্রিনশটের উপর আঁকুন। সাম্প্রতিক লগ এবং ডিভাইসের অবস্থা সংযুক্ত করা হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuixa sobre la captura per assenyalar el problema. S’hi adjunten els registres recents i l’estat del dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakreslete problém do snímku obrazovky. Přiložíme nedávné protokoly a stav zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn på skærmbilledet for at vise problemet. Seneste logs og enhedsstatus vedhæftes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιάστε πάνω στο στιγμιότυπο οθόνης για να δείξετε το πρόβλημα. Επισυνάπτονται πρόσφατα αρχεία καταγραφής και η κατάσταση της συσκευής."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی نماگرفت بکشید تا مشکل را نشان دهید. گزارش‌های اخیر و وضعیت دستگاه پیوست می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä ongelma piirtämällä kuvakaappaukseen. Viimeisimmät lokit ja laitteen tila liitetään mukaan."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crtajte po snimci zaslona da biste označili problem. Prilažu se nedavni zapisi i stanje uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajzolj a képernyőképre, hogy megmutasd a hibát. A legutóbbi naplókat és az eszköz állapotát is csatoljuk."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukis pada tangkapan skrin untuk menunjukkan masalahnya. Log terkini dan keadaan peranti turut dilampirkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn på skjermbildet for å vise problemet. Nylige logger og enhetsstatus legges ved."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe na captura para mostrar o problema. Os registos recentes e o estado do dispositivo seguem em anexo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenați pe captura de ecran ca să arătați problema. Jurnalele recente și starea dispozitivului sunt atașate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte problém na snímke obrazovky. Priložíme nedávne záznamy a stav zariadenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rišite po posnetku zaslona, da označite težavo. Priloženi so nedavni dnevniki in stanje naprave."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சிக்கலைச் சுட்டிக்காட்ட ஸ்கிரீன்ஷாட்டில் வரையவும். சமீபத்திய லாகுகளும் சாதன நிலையும் இணைக்கப்படும்."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez sur la capture d’écran pour montrer le problème. Les journaux récents et l’état de l’appareil sont joints."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在截圖上圈出問題所在。最近的記錄和裝置狀態會一併附上。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समस्या दाखवण्यासाठी स्क्रीनशॉटवर खुणा करा. अलीकडील लॉग आणि डिव्हाइसची स्थिती जोडली जातात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમસ્યા બતાવવા માટે સ્ક્રીનશૉટ પર દોરો. તાજેતરના લૉગ અને ડિવાઇસની સ્થિતિ જોડવામાં આવે છે."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమస్యను చూపడానికి స్క్రీన్‌షాట్‌పై గీయండి. ఇటీవలి లాగ్‌లు, పరికరం స్థితి జత చేయబడతాయి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രശ്നം ചൂണ്ടിക്കാണിക്കാൻ സ്ക്രീൻഷോട്ടിൽ വരയ്ക്കുക. സമീപകാല ലോഗുകളും ഉപകരണത്തിന്റെ നിലയും അറ്റാച്ച് ചെയ്തിട്ടുണ്ട്."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସମସ୍ୟା ଦେଖାଇବା ପାଇଁ ସ୍କ୍ରିନସଟ୍ ଉପରେ ଚିହ୍ନ ଆଙ୍କନ୍ତୁ। ସାମ୍ପ୍ରତିକ ଲଗ୍ ଏବଂ ଡିଭାଇସର ସ୍ଥିତି ସଂଲଗ୍ନ କରାଯାଇଛି।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಮಸ್ಯೆಯನ್ನು ತೋರಿಸಲು ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ನ ಮೇಲೆ ಗುರುತು ಮಾಡಿ. ಇತ್ತೀಚಿನ ಲಾಗ್‌ಗಳು ಮತ್ತು ಸಾಧನದ ಸ್ಥಿತಿಯನ್ನು ಲಗತ್ತಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਮੱਸਿਆ ਦਿਖਾਉਣ ਲਈ ਸਕ੍ਰੀਨਸ਼ਾਟ ’ਤੇ ਨਿਸ਼ਾਨ ਬਣਾਓ। ਹਾਲੀਆ ਲੌਗ ਅਤੇ ਡੀਵਾਈਸ ਦੀ ਸਥਿਤੀ ਨੱਥੀ ਕੀਤੇ ਜਾਂਦੇ ਹਨ।"
          }
        }
      }
    },
