    "Update your payment method to keep your subscription.": {
      "comment": "Detail line of the store action card for a billing issue.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّث طريقة الدفع للحفاظ على اشتراكك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Актуализирайте начина на плащане, за да запазите абонамента си."
