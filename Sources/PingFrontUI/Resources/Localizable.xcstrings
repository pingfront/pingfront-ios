          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس وقت چیٹ تک رسائی نہیں ہو پا رہی۔ چیٹ واپس آتے ہی پیغامات بھیج دیے جائیں گے۔"
