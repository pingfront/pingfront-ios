        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請更新付款方式，以保留你的訂閱。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे सदस्यत्व सुरू ठेवण्यासाठी तुमची पेमेंट पद्धत अपडेट करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું સબ્સ્ક્રિપ્શન ચાલુ રાખવા માટે તમારી ચુકવણી પદ્ધતિ અપડેટ કરો."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సబ్‌స్క్రిప్షన్‌ను కొనసాగించడానికి మీ చెల్లింపు పద్ధతిని అప్‌డేట్ చేయండి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സബ്സ്ക്രിപ്ഷൻ നിലനിർത്താൻ പേയ്‌മെന്റ് രീതി അപ്ഡേറ്റ് ചെയ്യുക."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ସବସ୍କ୍ରିପସନ୍ ଜାରି ରଖିବାକୁ ଆପଣଙ୍କ ପେମେଣ୍ଟ ପଦ୍ଧତି ଅପଡେଟ୍ କରନ୍ତୁ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸಬ್‌ಸ್ಕ್ರಿಪ್ಷನ್ ಮುಂದುವರಿಸಲು ಪಾವತಿ ವಿಧಾನವನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಿ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੀ ਗਾਹਕੀ ਜਾਰੀ ਰੱਖਣ ਲਈ ਭੁਗਤਾਨ ਵਿਧੀ ਅੱਪਡੇਟ ਕਰੋ।"
          }
