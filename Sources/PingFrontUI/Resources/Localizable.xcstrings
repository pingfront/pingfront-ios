    "Return on a keyboard sends; Shift-Return adds a line.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return on a keyboard sends; Shift-Return adds a line."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyede Return gönderir; Shift-Return satır ekler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Tastatur: Return sendet, Umschalt-Return fügt eine neue Zeile ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un teclado, Retorno envía; Mayúsculas-Retorno añade una línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un clavier, Retour envoie ; Maj-Retour ajoute une ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードではReturnで送信、Shift-Returnで改行します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على لوحة المفاتيح، يرسل Return؛ ويضيف Shift-Return سطرًا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em um teclado, Return envia; Shift-Return adiciona uma linha."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "En un teclado, Retorno envía; Mayúsculas-Retorno agrega una línea."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una tastiera, A capo invia; Maiusc-A capo aggiunge una riga."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op een toetsenbord verstuurt Return; Shift-Return voegt een regel toe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Return на клавиатуре отправляет, Shift-Return переносит строку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Return на клавіатурі надсилає, Shift-Return додає рядок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Return na klawiaturze wysyła, Shift-Return dodaje wiersz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På ett tangentbord skickar Retur meddelandet och Skift-Retur ger en ny rad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用键盘时，按 Return 发送，按 Shift-Return 换行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用鍵盤時，按 Return 傳送，按 Shift-Return 換行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드에서 Return을 누르면 전송되고, Shift-Return을 누르면 줄이 바뀝니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên bàn phím, nhấn Return để gửi, Shift-Return để xuống dòng."
          }
