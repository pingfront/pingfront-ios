        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không thể kết nối với cuộc trò chuyện. Tin nhắn sẽ được gửi khi kết nối trở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
