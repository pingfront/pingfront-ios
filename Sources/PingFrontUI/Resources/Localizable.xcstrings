          "stringUnit": {
            "state": "translated",
            "value": "Rispondi se vuoi, oppure ignoralo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoord als je wilt, of negeer het."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно ответить или просто пропустить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна відповісти або просто пропустити."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz odpowiedzieć albo to zignorować."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svara om du vill, eller strunta i det."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想回复就回复，不回也没关系。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想回覆就回覆，不回也沒關係。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하면 답장하거나 그냥 넘어가도 됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể trả lời hoặc bỏ qua."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะตอบกลับหรือไม่ก็ได้"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להשיב, ואפשר גם להתעלם."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چاہیں تو جواب دیں، یا نظر انداز کر دیں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चाहें तो जवाब दें, या इसे अनदेखा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Balas jika Anda mau, atau abaikan saja."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете да отговорите или да го пренебрегнете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চাইলে উত্তর দিন, না হলে এড়িয়ে যান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Respon si vols, o ignora’l."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete odpovědět, nebo ji ignorovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar, hvis du vil, eller lad være."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να απαντήσετε ή να το αγνοήσετε."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر خواستید پاسخ دهید، یا نادیده بگیرید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit vastata, jos haluat, tai jättää viestin huomiotta."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete odgovoriti ili je zanemariti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha szeretnél, válaszolj, vagy hagyd figyelmen kívül."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Balas jika anda mahu, atau abaikan sahaja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar hvis du vil, eller la være."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda se quiser, ou ignore."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspundeți dacă doriți sau ignorați-l."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžete odpovedať alebo ju ignorovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahko odgovorite ali ga prezrete."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விரும்பினால் பதிலளிக்கவும், இல்லையெனில் இதைப் புறக்கணிக்கவும்."
