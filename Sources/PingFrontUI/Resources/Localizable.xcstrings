    "This chat is paused for now.": {
      "comment": "In place of the composer while the app is paused. It asks nothing of the person: their held messages send by themselves when it reopens.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الدردشة متوقفة مؤقتًا حاليًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този чат е спрян временно."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই চ্যাট এখন সাময়িকভাবে বন্ধ আছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest xat està en pausa de moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento chat je zatím pozastavený."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatten er sat på pause indtil videre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Chat ist vorerst pausiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η συνομιλία έχει τεθεί προσωρινά σε παύση."
