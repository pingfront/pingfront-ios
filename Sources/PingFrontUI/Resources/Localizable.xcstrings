          "stringUnit": {
            "state": "translated",
            "value": "質問、不具合、アイデア：%@の開発者がすべてのメッセージを読み、ここで返信します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسئلة أو أخطاء أو أفكار: مطوّرو %@ يقرؤون كل رسالة ويردّون هنا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dúvidas, bugs ou ideias: quem faz %@ lê cada mensagem e responde aqui."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntas, errores o ideas: quienes hacen %@ leen cada mensaje y responden aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Domande, bug o idee: chi crea %@ legge ogni messaggio e risponde qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vragen, bugs of ideeën: de makers van %@ lezen elk bericht en antwoorden hier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопросы, ошибки или идеи: создатели %@ читают каждое сообщение и отвечают здесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Питання, помилки чи ідеї: творці %@ читають кожне повідомлення й відповідають тут."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytania, błędy lub pomysły: twórcy %@ czytają każdą wiadomość i odpowiadają tutaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frågor, fel eller idéer: de som gör %@ läser varje meddelande och svarar här."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有疑问、遇到 bug 或有想法？%@ 的开发者会阅读每一条消息，并在这里回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有疑問、遇到錯誤或有想法？%@ 的開發者會閱讀每則訊息，並在這裡回覆。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문, 버그, 아이디어 모두 환영합니다. %@ 개발자가 모든 메시지를 읽고 여기에서 답장합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu hỏi, lỗi hay ý tưởng: những người làm ra %@ đọc mọi tin nhắn và trả lời tại đây."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคำถาม เจอบั๊ก หรือมีไอเดีย ทีมผู้สร้าง %@ อ่านทุกข้อความและตอบกลับที่นี่"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שאלות, באגים או רעיונות: האנשים שמפתחים את %@ קוראים כל הודעה ועונים כאן."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سوالات، خرابیاں یا آئیڈیاز: %@ بنانے والے ہر پیغام پڑھتے ہیں اور یہیں جواب دیتے ہیں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सवाल, बग या आइडिया: %@ बनाने वाले हर मैसेज पढ़ते हैं और यहीं जवाब देते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertanyaan, bug, atau ide: orang-orang yang membuat %@ membaca setiap pesan dan membalas di sini."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въпроси, грешки или идеи: хората, които създават %@, четат всяко съобщение и отговарят тук."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রশ্ন, বাগ বা আইডিয়া: যাঁরা %@ বানিয়েছেন, তাঁরা প্রতিটি মেসেজ পড়েন এবং এখানেই উত্তর দেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntes, errors o idees: les persones que fan %@ llegeixen cada missatge i responen aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotazy, chyby nebo nápady: tvůrci aplikace %@ čtou každou zprávu a odpovídají tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørgsmål, fejl eller idéer: dem, der laver %@, læser hver besked og svarer her."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ερωτήσεις, σφάλματα ή ιδέες: οι άνθρωποι που φτιάχνουν την εφαρμογή %@ διαβάζουν κάθε μήνυμα και απαντούν εδώ."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سؤال، اشکال یا ایده: سازندگان %@ همهٔ پیام‌ها را می‌خوانند و همین‌جا پاسخ می‌دهند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysymykset, virheet tai ideat: sovelluksen %@ tekijät lukevat jokaisen viestin ja vastaavat tähän."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitanja, pogreške ili ideje: ljudi koji izrađuju aplikaciju %@ čitaju svaku poruku i odgovaraju ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérdés, hiba vagy ötlet? %@ készítői minden üzenetet elolvasnak, és itt válaszolnak."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Soalan, pepijat atau idea: orang yang membina %@ membaca setiap mesej dan membalas di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørsmål, feil eller ideer: de som lager %@, leser hver melding og svarer her."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dúvidas, erros ou ideias: quem faz %@ lê todas as mensagens e responde aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întrebări, erori sau idei: cei care fac %@ citesc fiecare mesaj și răspund aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otázky, chyby alebo nápady: tvorcovia aplikácie %@ čítajú každú správu a odpovedajú tu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vprašanja, napake ali ideje: ljudje, ki izdelujejo aplikacijo %@, preberejo vsako sporočilo in odgovorijo tukaj."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேள்விகள், பிழைகள், யோசனைகள்: %@ ஆப்ஸை உருவாக்கியவர்கள் ஒவ்வொரு மெசேஜையும் படித்து இங்கேயே பதிலளிப்பார்கள்."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions, bogues ou idées : l’équipe derrière %@ lit chaque message et vous répond ici."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "有疑問、遇到錯誤或有想法？%@ 的開發者會閱讀每則訊息，並在這裡回覆。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रश्न, बग किंवा कल्पना: %@ बनवणारे लोक प्रत्येक मेसेज वाचतात आणि येथेच उत्तर देतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રશ્નો, બગ અથવા આઇડિયા: %@ બનાવનારા લોકો દરેક મેસેજ વાંચે છે અને અહીં જ જવાબ આપે છે."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రశ్నలు, బగ్‌లు లేదా ఐడియాలు: %@ని రూపొందించే వ్యక్తులు ప్రతి మెసేజ్‌ను చదివి ఇక్కడే రిప్లై ఇస్తారు."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചോദ്യങ്ങൾ, ബഗുകൾ, ആശയങ്ങൾ: %@ നിർമ്മിക്കുന്നവർ ഓരോ മെസേജും വായിച്ച് ഇവിടെ മറുപടി നൽകുന്നു."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରଶ୍ନ, ବଗ୍ କିମ୍ବା ଆଇଡିଆ: %@ ତିଆରି କରୁଥିବା ଲୋକମାନେ ପ୍ରତ୍ୟେକ ମେସେଜ୍ ପଢ଼ନ୍ତି ଏବଂ ଏଠାରେ ଉତ୍ତର ଦିଅନ୍ତି।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಶ್ನೆಗಳು, ಬಗ್‌ಗಳು ಅಥವಾ ಆಲೋಚನೆಗಳು: %@ ಆ್ಯಪ್ ಅನ್ನು ತಯಾರಿಸುವವರು ಪ್ರತಿಯೊಂದು ಮೆಸೇಜ್ ಅನ್ನು ಓದುತ್ತಾರೆ ಮತ್ತು ಇಲ್ಲಿಯೇ ಉತ್ತರಿಸುತ್ತಾರೆ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਵਾਲ, ਬੱਗ ਜਾਂ ਵਿਚਾਰ: %@ ਬਣਾਉਣ ਵਾਲੇ ਹਰ ਮੈਸੇਜ ਪੜ੍ਹਦੇ ਹਨ ਅਤੇ ਇੱਥੇ ਹੀ ਜਵਾਬ ਦਿੰਦੇ ਹਨ।"
          }
        }
      }
    },
