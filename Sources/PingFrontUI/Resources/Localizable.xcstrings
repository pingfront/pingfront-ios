        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimiterea este întreruptă temporar. Încercați din nou mai târziu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odosielanie je na chvíľu pozastavené. Skúste to neskôr."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošiljanje je začasno ustavljeno. Poskusite znova pozneje."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனுப்புவது சிறிது நேரத்துக்கு இடைநிறுத்தப்பட்டுள்ளது. பிறகு மீண்டும் முயலவும்."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi est suspendu pour le moment. Réessayez plus tard."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法傳送，請稍後再試。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठवणे काही काळासाठी थांबवले आहे. नंतर पुन्हा प्रयत्न करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મોકલવાનું થોડા સમય માટે અટકાવ્યું છે. થોડી વાર પછી ફરી પ્રયાસ કરો."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పంపడం కొంత సమయం పాటు పాజ్ చేయబడింది. తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അയയ്ക്കുന്നത് കുറച്ചുനേരത്തേക്ക് നിർത്തിവച്ചിരിക്കുന്നു. പിന്നീട് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପଠାଇବା କିଛି ସମୟ ପାଇଁ ବିରତ ଅଛି। ପରେ ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಳುಹಿಸುವುದನ್ನು ಸ್ವಲ್ಪ ಸಮಯದವರೆಗೆ ವಿರಾಮಗೊಳಿಸಲಾಗಿದೆ. ನಂತರ ಮತ್ತೊಮ್ಮೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਭੇਜਣਾ ਕੁਝ ਸਮੇਂ ਲਈ ਰੁਕਿਆ ਹੋਇਆ ਹੈ। ਬਾਅਦ ਵਿੱਚ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        }
      }
    },
