    },
    {
      "name": "intent in capitals",
      "url": "INTENT://scan/#Intent;end"
    },
    {
      "name": "no scheme",
      "url": "example.com/help"
    },
    {
      "name": "a path only",
      "url": "/help"
    },
    {
      "name": "empty",
      "url": ""
